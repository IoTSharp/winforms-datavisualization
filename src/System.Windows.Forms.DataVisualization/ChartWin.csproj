<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>System.Windows.Forms.DataVisualization</RootNamespace>
    <AssemblyName>IoTSharp.WinForms.DataVisualization</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CLSCompliant>false</CLSCompliant>
    <NoWarn>$(NoWarn);618</NoWarn>
    <!-- SR.cs intentionally uses a conditional namespace; the resource logical name is explicit below. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3042</MSBuildWarningsAsMessages>
    <DefineConstants>$(DefineConstants);WINFORMS_CONTROL</DefineConstants>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>10.0.0</Version>
    <PackageId>IoTSharp.WinForms.DataVisualization</PackageId>
    <Authors>IoTSharp</Authors>
    <Description>Windows Forms chart controls for .NET 10. The public System.Windows.Forms.DataVisualization namespaces are preserved.</Description>
    <PackageTags>winforms;chart;datavisualization;dotnet10</PackageTags>
    <RepositoryUrl>https://github.com/IoTSharp/winforms-datavisualization</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <Win32Manifest>Resources\System\Windows\Forms\XPThemes.manifest</Win32Manifest> -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Annotation\AnnotationDesign.cs" />
    <Compile Remove="Common\EditorNames.cs" />
  </ItemGroup>

  <ItemGroup Label="Embedded Resources">
    <EmbeddedResource Update="Common\SR.resx">
      <LogicalName>System.Windows.Forms.DataVisualization.Charting.SR.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="SR.resx">
      <GenerateSource>true</GenerateSource>
      <Namespace>System.Windows.Forms.DataVisualization.Charting</Namespace>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
